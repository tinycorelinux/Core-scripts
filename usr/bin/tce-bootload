#!/usr/bin/micropython

import os
import sys
import utime

import tc

if len(sys.argv) < 3:
	print(f"Usage: {sys.argv[0]} <tcedir> <tcz1> [tcz2 ...]")
	print("\n -This program is normally only used during boot to parallelize extension loading.\n")
	sys.exit(1)

maxforks = tc.cpunr

def mklog(s):
	global tm

	t = utime.time()

	fp = open("/tmp/bootlog.txt", "at")
	fp.write(f"{t - tm:6.1f} - {s}\n")
	fp.close()

	tm = t

def debuglog(s):
	fp = open("/tmp/debugboot.log", "at")
	fp.write(f"{s}\n")
	fp.close()

def system_command(cmd,ext):
	retries=4
	while retries > 0:
		try:
			ret=os.system(cmd)
			if ret != 0:
				if debug:
					debuglog(f"OS Error code {ext}:{ret}\n")
				retries -= 1
			else:
				if (retries != 4):
					if debug:
						debuglog(f"Successful Retry on {ext}\n")
				break
		except OSError:
			retries -= 1
			continue
	if (retries == 0):
		if debug:
			debuglog(f"\nToo many retries: {ext}\n")


root = ""

tczout = []
tczin = []
copy2fslst = []
pid = 0

showapps = "showapps" in tc.cmdline
debug = "debugbootload" in tc.cmdline

tm = utime.time()

tcedir = sys.argv[1]

for p in sys.argv[2:]:
	s = p.replace("KERNEL", tc.kernel)

	if (s in tczin) == False:
		tczin.append(s)

#Build tcz list to load, with duplicate checking
while len(tczin) > 0:
	try:
		for p in tc.readtczlist(f"{tcedir}/optional/{tczin[0]}.dep"):
			try:
				tczout.index(p)
				continue
			except ValueError:
				pass

			try:
				tczin.index(p)
				continue
			except ValueError:
				pass

			tczin.append(p)

	except OSError:
		pass

	tczout.append(tczin[0])
	del tczin[0]

#Make sure all extensions in list are really there.
for p in tczout:
   if not os.access(f"{tcedir}/optional/{p}", os.R_OK):
		tczout.remove(p)
		debuglog(f"Warning: {p} Not Found. Extension was in onboot.lst or dependancies.")

mklog("Build TCZ list")
if debug:
	debuglog(f"Built TCZ list: {' '.join(tczout)}")

# Mount extensions

if showapps:
    print()
    print("\033[1;33mMounting extensions")
    print("-------------------")
    print()

forks = 0

for p in tczout:

	pid = os.fork()

	if pid == 0:
		#This is the child process.

		base = p[:-4]

		if showapps:
			print(f"{base} ", end="")
			print("\033[1;33m", end="")


		os.mkdir(f"{root}/tmp/tcloop/{base}")
		system_command(f"sudo /usr/bin/mount -t squashfs -o loop {tcedir}/optional/{p} {root}/tmp/tcloop/{base}", base)
		#Child process exits
		sys.exit(0)
	else:
		#This is the parent process
		if debug:
			debuglog(f"PID:{pid} Started for mounting {p}")
		forks += 1

		# Start forks up to the number of cpu cores.
		if forks >= maxforks:
			tmp=os.waitpid(0, 0)
			if debug:
				debuglog(f"PID:{tmp[0]} Finished, exit code: {tmp[1]}")
			forks -= 1
		pid = 0

# There are multiple forks running, wait for them to finish.
for j in range(forks):
	tmp=os.waitpid(0, 0)
	if debug:
		debuglog(f"PID:{tmp[0]} Finished, exit code: {tmp[1]}")

mklog(f"Mount TCZ ({len(tczout)})")
if debug:
	debuglog(f"Mount TCZ ({len(tczout)})")

# Check for copy2fs.  flg will override lst
try:
	fp = open(f"{tcedir}/copy2fs.flg", "r")
	fp.close()
	copy2fsflg = True
except OSError:
	copy2fsflg = False

if not copy2fsflg:
	try:
		# Check for copy2fs.lst and read list if present.
		for p in tc.readtczlist(f"{tcedir}/copy2fs.lst"):
			try:
				copy2fslst.index(p)
				continue
			except ValueError:
				pass

			copy2fslst.append(p)
	except OSError:
		pass

# Add extensions to file system

if showapps:
	print()
	print()
	print("Adding extensions to file system")
	print("--------------------------------")
	print()

forks = 0

for p in tczout:

	pid = os.fork()

	base = p[:-4]

	if pid == 0:
		#This is the child process
		if showapps:
			print(f"{base} ", end="")

		if copy2fsflg or p in copy2fslst:
			if debug:
				debuglog("Copy2fs for %s" % p)

			system_command(f"yes n 2>/dev/null | sudo busybox cp -ai {root}/tmp/tcloop/{base}/. {root}/ 2>/dev/null", base)
			system_command(f"sudo busybox.suid umount {root}/tmp/tcloop/{base}", base)
			system_command(f"sudo busybox rm -r -f {root}/tmp/tcloop/{base}", base)
		else:
			if debug:
				debuglog(f"Copy AIS for {root}/tmp/tcloop/{base}")
			system_command(f"yes n 2>/dev/null | sudo busybox cp -ais {root}/tmp/tcloop/{base}/. {root}/ 2>/dev/null", base)
		#The child process exits.
		sys.exit(0)
	else:
		if debug:
			debuglog(f"PID:{pid} Started for copying {p}")
		forks += 1
		if forks >= maxforks:
			tmp=os.waitpid(0, 0)
			if debug:
				debuglog(f"PID:{tmp[0]} Finished, exit code: {tmp[1]}")
			forks -= 1
		pid = 0

# There are multiple forks running, wait for them to finish.
for j in range(forks):
	tmp=os.waitpid(0, 0)
	if debug:
		debuglog(f"PID:{tmp[0]} Finished, exit code: {tmp[1]}")

mklog("Add to file system")
if debug:
	debuglog("Add to file system")

pid = os.fork()
if pid == 0:
	st = os.system("sudo /sbin/ldconfig")
	sys.exit(0)
else:
	if debug:
		debuglog(f"PID:{pid} Started for ldconfig")

pid = os.fork()
if pid == 0:
	st = os.system("sudo /sbin/depmod -b /")
	sys.exit(0)
else:
	if debug:
		debuglog(f"PID:{pid} Started for depmod")

# Verify permissions on tce.installed incase bad extension changed it.
pid = os.fork()
if pid == 0:
	st1 = os.system("sudo chown -R root:staff /usr/local/tce.installed")
	st2 = os.system("sudo chmod -R 775 /usr/local/tce.installed")
	sys.exit(0)
else:
	if debug:
		debuglog(f"PID:{pid} Started for chown")

#Wait for previous 3 forks to finish.
for i in range(3):
	tmp=os.waitpid(0, 0)
	if debug:
		debuglog(f"PID:{tmp[0]} Finished, exit code: {tmp[1]}")

# Executing startup scripts

if showapps:
	print()
	print()
	print("Executing startup scripts")
	print("-------------------------")
	print("\033[0;39m")

forks = 0

# Scan for extension load scripts, and run them if found.
for p in tczout:

	base = p[:-4]

	script = f"/usr/local/tce.installed/{base}"
	pid = os.fork()

	if pid == 0:
		if showapps:
			print(f"{base} ", end="")

		if os.access( script, os.X_OK) == True:
			if debug:
				debuglog(f"Executing: {script}")
			system_command(f"sudo {script}", script)
		else:
			#if no startup script is there, create an empty file needed.
			try:
				with open(f"{root}/usr/local/tce.installed/{base}", "wb") as fp:
					fp.write(b"\x00")
			except OSError:
				pass
		sys.exit(0)
	else:
		if debug:
			debuglog(f"PID:{pid} Started for {p}")
		forks += 1
		f = forks
		if forks >= maxforks:
			tmp=os.waitpid(0, 0)
			if debug:
				debuglog(f"PID:{tmp[0]} Finished, exit code: {tmp[1]}")
			forks -= 1

for j in range(forks):
	tmp=os.waitpid(0, 0)
	if debug:
		debuglog(f"PID:{tmp[0]} Finished, exit code: {tmp[1]}")

mklog("Execute startup scripts")

os.system("sudo /sbin/udevadm trigger")

mklog("udev trigger")
